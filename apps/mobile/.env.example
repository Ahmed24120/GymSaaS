# Supabase Configuration for GymSaaS Mobile App (Expo)
# Access via process.env.EXPO_PUBLIC_* in Expo SDK 51+
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# App Environment
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEFAULT_GYM_ID=gym-001
