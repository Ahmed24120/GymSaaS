# Configuration Expo pour l'application Mobile GymSaaS
# Variables accessibles via process.env.EXPO_PUBLIC_* (Expo SDK 51+)
# RÈGLE ABSOLUE : Uniquement des clés publiques (anon key). JAMAIS de service_role ni de secret de signature !

# URL de l'API web déployée (pour GET /api/qr)
EXPO_PUBLIC_API_URL=https://gymsaas.vercel.app

# Supabase (clés publiques anonymes uniquement)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Paramètres optionnels
EXPO_PUBLIC_APP_ENV=development
