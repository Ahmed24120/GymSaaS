{
  "expo": {
    "name": "GymSaaS",
    "slug": "gymsaas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0b0f17"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "يحتاج التطبيق للكاميرا لمسح رمز QR الخاص بالأعضاء"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0f17"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "السماح للتطبيق باستخدام الكاميرا لمسح رمز QR الخاص بالأعضاء"
        }
      ]
    ]
  }
}
