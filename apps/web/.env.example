# Supabase Configuration for GymSaaS Web Management
# Get these credentials from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Server-side secret key for admin edge functions ONLY
# CAUTION: NEVER expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=Nouakchott
NEXT_PUBLIC_DEFAULT_CURRENCY=MRU
