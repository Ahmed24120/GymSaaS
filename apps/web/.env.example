# ==============================================================================
# GymSaaS — Variables d'environnement Web (Next.js)
# Copier ce fichier vers apps/web/.env.local et renseigner les vraies valeurs.
# RÈGLE ABSOLUE : Ne jamais commiter de secrets ou de clés réelles dans git.
# ==============================================================================

# 1. Supabase (Clés publiques accessibles côté navigateur)
# Obtenues dans : Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Sécurité Cryptographique des QR Codes (SERVEUR UNIQUEMENT)
# Clé secrète HMAC-SHA256 pour signer les QR codes.
# ATTENTION DE SÉCURITÉ : Ne JAMAIS préfixer par NEXT_PUBLIC_ !
# Générer avec : openssl rand -base64 32
QR_SIGNING_SECRET=your-32-byte-base64-secret-here
