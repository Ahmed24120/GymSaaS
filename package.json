{
  "name": "gymsaas-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant Gym Management SaaS for Nouakchott & Mauritania",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@gymsaas/web",
    "build:web": "npm run build --workspace=@gymsaas/web",
    "start:web": "npm run start --workspace=@gymsaas/web"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
